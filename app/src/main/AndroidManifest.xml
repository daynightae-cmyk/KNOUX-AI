<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <!--
      Storage access is requested per use case, never as a blanket grant.

      API 33+ replaces READ_EXTERNAL_STORAGE with granular media permissions. Only
      images and video are declared because Smart Clean and Duplicate Finder work
      on visual media; audio is deliberately NOT requested until a service that
      genuinely needs it exists.

      READ_MEDIA_VISUAL_USER_SELECTED (API 34+) lets the customer grant access to
      a chosen subset instead of the whole library. When it is present the app
      must offer re-selection, which SmartCleanRepository does.

      READ_EXTERNAL_STORAGE is capped at API 32, where granular permissions do not
      exist yet, so newer devices never receive an over-broad legacy grant.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Ignored below API 34 by the platform; no minSdk attribute exists on
         uses-permission, so the version gate is applied in PermissionState. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <application android:allowBackup="false" android:label="KNOUX AI" android:supportsRtl="true"
        android:theme="@style/Theme.Knoux" android:icon="@drawable/ic_knoux">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
